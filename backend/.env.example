# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rstms_db
DB_USER=rstms_user
DB_PASS=your_secure_password_here

# Database Sync Configuration
# Set DB_SYNC=true only when you need to sync schema (creates missing tables)
# Leave unset or false for normal operation to prevent repeated ALTER TABLE operations
DB_SYNC=false
# Set DB_LOGGING=true to see SQL queries in console (useful for debugging)
DB_LOGGING=false

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_min_32_characters_long
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_characters_long
JWT_EXPIRY=8h
JWT_REFRESH_EXPIRY=7d

# Security
MAX_LOGIN_ATTEMPTS=5
BCRYPT_ROUNDS=10

# Business Configuration
VAT_RATE=0.18
CURRENCY=UGX
LOW_STOCK_ALERT_DAYS=7
EXPIRY_ALERT_DAYS=7

# Backup Configuration
BACKUP_PATH=/var/backups/rstms
BACKUP_RETENTION_DAYS=7

# Email Configuration (Optional)
ALERT_EMAIL=admin@supermarket.ug
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Redis Configuration (Optional)
REDIS_URL=redis://127.0.0.1:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# Pesapal API 3.0 Configuration
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=your_consumer_key_here
PESAPAL_CONSUMER_SECRET=your_consumer_secret_here

# Payment Confirmation Mode
# polling = Frontend polls for status (works on localhost/LAN - no public URL needed)
# webhook = Pesapal pushes notifications (requires public URL - for production only)
PESAPAL_MODE=polling

# Network Configuration (optional - only used if PESAPAL_MODE=webhook)
# Use your local network IP instead of localhost so Pesapal can reach your webhook
# Find your IP: ifconfig (Linux/Mac) or ipconfig (Windows)
NETWORK_IP=192.168.1.100

# Custom Webhook URL (optional - only used if PESAPAL_MODE=webhook)
# For production deployment with public domain
# PESAPAL_WEBHOOK_URL=https://yourdomain.com/api/v1/payments/webhook
